# Dockerfile for building Baritone for Minecraft 1.21.11
# This creates a reproducible build that anyone can run
FROM gradle:8.5-jdk21 AS baritone-builder

# Clone Baritone repository
WORKDIR /build
RUN git clone --depth 1 https://github.com/cabaletta/baritone.git .

# Modify gradle.properties to target Minecraft 1.21.11
RUN sed -i 's/^minecraft_version=.*/minecraft_version=1.21.11/' gradle.properties

# Build Baritone API JAR
RUN ./gradlew build -x test --no-daemon || true

# Extract the built JAR
RUN find build/libs -name "baritone-api-*.jar" -exec cp {} /build/baritone-api-forge-1.15.0.jar \;

# Minimal output stage - just the JAR
FROM scratch AS artifact
COPY --from=baritone-builder /build/baritone-api-forge-1.15.0.jar /
